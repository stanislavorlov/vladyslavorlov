<html xmlns="http://www.w3.org/1999/xhtml" xmlns:fb="https://www.facebook.com/2008/fbml">
<head>
    <title>Vladyslav Orlov - Official Website</title>
    @Styles.Render("~/Content/css")

    <link href="http://fonts.googleapis.com/css?family=Raleway:400,300,600" rel="stylesheet" type="text/css">
    @Styles.Render("~/Content/lightsliderstyles")
    
    <link rel="stylesheet" href="~/Content/jClocksGMT.css"/>

    <link rel="icon" href="@Url.Content("~/favicon.ico")?v=2" type="image/x-icon" />
    <link rel="shortcut icon" href="@Url.Content("~/favicon.ico")?v=2" type="image/x-icon" />
</head>
<body>
    <div class="header">
        @*<img src="~/images/tennis_header.jpg" alt="">*@
        <div style="top: 0px;right: 0px;float: right;">
            <div id="clock_korea"></div>
        </div>
    </div>
<div class="container">
    <header>
        <div class="subheader">
            <div class="col">
                <img src="~/images/logo2.png" class="logo" alt="logo"/>
            </div>
            <div class="col title">
                <h1>Vladyslav Orlov - Official Website</h1>
                <div class="descr">Professional tennis player</div>
            </div>
        </div>
        <div id="sliderContainer"></div>
    </header>
    <nav id="nav">
        <ul id="mainMenu">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Home")">Home</a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "News")">News</a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Profile")">Profile</a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Sponsors")">Sponsors</a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Contact")">Contact</a>
            </li>
        </ul>
    </nav>
    <div id="content">
        @RenderBody()
    </div>
    <div id="footer">
        <hr/>
        <div class="counters">
            <ul>
                <li class="item" style="padding-top: 19px; float: left">
                    <script src="https://www.w3counter.com/tracker.js?id=114557"></script>
                </li>
                <li class="item" style="margin-left: 10px; float: right">
                    <a href='https://www.counters-free.net/'>counters-free.net</a>
                    <script type='text/javascript' src='https://www.freevisitorcounters.com/auth.php?id=ff9cb1e64158b8a3955abb86238820244def5c3f'></script>
                    <script type="text/javascript" src="https://www.freevisitorcounters.com/en/home/counter/318835/t/0"></script>
                </li>
            </ul>
            <div style="clear: both"></div>
        </div>
    </div>
</div>
<div class="copyright">
    <div>© @DateTime.Now.Year VladyslavOrlov.com - Official Website | All rights reserved</div>
</div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/jClocksGMT.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.rotate.js" type="text/javascript"></script>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-109735603-1"></script>
<script>
    window.dataLayer = window.dataLayer || [];

    function gtag() { dataLayer.push(arguments); }

    gtag('js', new Date());

    gtag('config', 'UA-109735603-1');

    $(document).ready(function() {
        $('#clock_korea').jClocksGMT({
            title: 'Kyiv, Ukraine',
            offset: '+2',
            skin: 3,
            date: true
        });

        $('#sliderContainer').load('@Url.Action("Slider", "Home")');
    });
</script>
    
</body>
</html>