@model VladyslavOrlovPromo.Models.AdminLoginModel

@{
    ViewBag.Title = "Index";
}

<h2>Administration</h2>

@using (Html.BeginForm())
{
    <div>
        @Html.LabelFor(m => m.Username, "Please enter your Username")
        @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
        <div>
            @Html.ValidationMessageFor(m => m.Username)
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Password, "Please enter your Password")
        @Html.TextBoxFor(m => m.Password, new {@class = "form-control", type = "password"})
        <div>
            @Html.ValidationMessageFor(m => m.Password)
        </div>
    </div>
    <div class="form-group">
        <input type="submit" class="btn" value="Login"/>
    </div>
}