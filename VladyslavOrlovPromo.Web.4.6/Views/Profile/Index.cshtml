
@{
    ViewBag.Title = "Index";
}

<style>
    .rank {
        width: 100%;
        border: 1px solid silver;
        padding: 0px;
        line-height: 40px;
    }

        .rank th {
            padding: 5px 15px;
            background-color: #f8f8f8;
            border-top: 1px solid #ececec;
            text-transform: uppercase;
        }

        .rank td {
            width: 33%;
            text-align: center;
        }
</style>

<h2>Profile</h2>

<img src="~/images/ranking_history.png"/>

@Html.Raw(ViewBag.rank)

<div>
    <div class="column">
        <h2>About Vladyslav Orlov</h2>

        <div class="about">
            <ul>
                <li>Began playing tennis at age 8</li>
                <li>Debuted on the ATP Tour in 2014</li>
                <li>Date of birth: 17 May 1995</li>
                <li>Birth Place: Kharkov, Ukraine</li>
                <li>Plays: Right-Handed</li>
            </ul>
        </div>
    </div>
    <div class="column" style="text-align: right">
        <img src="~/images/avatar.jpg" style="height: 350px;" alt=""/>
    </div>
</div>