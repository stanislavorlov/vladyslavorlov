@model List<VladyslavOrlovPromo.DataAccess.Post>

@{
    ViewBag.Title = "Index";
}

<div class="sociallinks" style="width: 270px; margin: 0 auto;">
    <ul>
        <li>
            <a href="https://www.facebook.com/vlad1orlov/" target="_blank">
                <img src="~/images/facebook.png" alt=""/>
            </a>
        </li>
        <li>
            <a href="https://www.instagram.com/orlovgram/" target="_blank">
                <img src="~/images/instagram.png" alt=""/>
            </a>
        </li>
    </ul>
</div>

<div style="margin-bottom: 50px;">
    @foreach (var post in Model)
    {
        <article style="border-bottom: 1px solid #ddd;">
            <header>
                <h1>@post.Title</h1> @if (ViewBag.IsAdmin == true)
                                     {
                                         <span><a href="/Admin/Edit?id=@post.Id">Edit</a></span><span>&nbsp;&nbsp;&nbsp;</span><span><a href="/Admin/Delete?id=@post.Id">Delete</a></span> }
            </header>
            <div style="color: #666; clear: both; font-size: 12px; line-height: 18px;">
                Posted on @post.DateCreated.Value.ToString("D")
            </div>
            <div style="padding: 1.625em 0 0;">
                <p>
                    @Html.Raw(System.Text.Encoding.ASCII.GetString(post.Content))
                </p>
            </div>
        </article>
    }

    @if (ViewBag.displayOlderPosts == true)
    {
        <div class="nav-previous">
            <a href="@Url.Action("Next", new {page = ViewBag.nextPage})">
                <span class="meta-nav">←</span> Older posts
            </a>
        </div>
    }
</div>