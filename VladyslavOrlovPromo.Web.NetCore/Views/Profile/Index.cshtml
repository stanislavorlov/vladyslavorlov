@model VladyslavOrlovPromo.Web.NetCore.Models.RankingViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Vladyslav Orlov Overview</h1>

<div>
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#singles" role="tab" aria-controls="singles" aria-selected="true">Singles</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#doubles" role="tab" aria-controls="doubles" aria-selected="false">Doubles</a>
        </li>
    </ul>

    <div class="tab-content">
        <div id="singles" class="tab-pane fade show active" role="tabpanel">
            <dl class="row"></dl>
            <div class="container">
                <div class="row card-title">Current Rankings</div>
                @await Html.PartialAsync("RankingPartial", Model.Singles.Current)
                <div class="row card-title mt-5">Career-High Rankings</div>
                @await Html.PartialAsync("RankingPartial", Model.Singles.Highest)
            </div>
        </div>
        <div id="doubles" class="tab-pane fade" role="tabpanel">
            <dl class="row"></dl>
            <div class="container">
                <div class="row card-title">Current Rankings</div>
                @await Html.PartialAsync("RankingPartial", Model.Doubles.Current)
                <div class="row card-title mt-5">Career-High Rankings</div>
                @await Html.PartialAsync("RankingPartial", Model.Doubles.Highest)
            </div>
        </div>
    </div>

    <dl class="row">
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new { /* id = Model.PrimaryKey */ }) |
    <a asp-action="Index">Back to List</a>
</div>
