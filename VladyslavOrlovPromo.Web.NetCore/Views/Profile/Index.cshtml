@using VladyslavOrlovPromo.Core.Enums

@{
    ViewData["Title"] = "Index";
}

<h1>Vladyslav Orlov Overview</h1>

<div>
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#singles" role="tab" aria-controls="singles" aria-selected="true">Singles</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#doubles" role="tab" aria-controls="doubles" aria-selected="false">Doubles</a>
        </li>
    </ul>

    <div class="tab-content">
        <div id="singles" class="tab-pane fade show active" role="tabpanel">
            @*await Component.InvokeAsync("ShowRankSummary", new { matchType = MatchTypeCode.Singles.Value })*@
        </div>
        <div id="doubles" class="tab-pane fade" role="tabpanel">
            @*await Component.InvokeAsync("ShowRankSummary", new { matchType = MatchTypeCode.Doubles.Value })*@
        </div>
    </div>

    <dl class="row">
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new { /* id = Model.PrimaryKey */ }) |
    <a asp-action="Index">Back to List</a>
</div>
